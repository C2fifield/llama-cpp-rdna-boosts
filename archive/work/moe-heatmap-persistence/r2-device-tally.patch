+// wip/moe-heatmap-persistence (R2): device-side prefill routing tally.  Reads the raw routing ids on
+// the device (the OUTER `mul_mat_id` entry, before the cache's slot-remap redirect), so it counts the
+// true expert ids for every prefill path - including the staged path (where the host hook is skipped)
+// and the identity path (where the host hook is short-circuited).  Prefill band only: the decode band
+// is tallied on the host by `moe_cache_update_host`, so there is no double count and no extra launch on
+// the latency-critical decode path.
+static __global__ void moe_cache_heat_kernel(const int32_t * __restrict__ ids, int64_t nb0, int64_t nb1,
+                                             int n_used, int n_tok, int n_experts,
+                                             uint32_t * __restrict__ heat) {
+    const int64_t n = (int64_t) n_used * (int64_t) n_tok;
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < n;
+         i += (int64_t) gridDim.x * blockDim.x) {
+        const int64_t tok = n_used > 0 ? i / n_used : 0;
+        const int64_t j   = n_used > 0 ? i % n_used : 0;
+        const int32_t e = *(const int32_t *) ((const char *) ids + (size_t) tok * (size_t) nb1 +
+                                              (size_t) j * (size_t) nb0);
+        if (e >= 0 && e < n_experts) {
+            atomicAdd(&heat[e], 1u);
+        }
+    }
+}
