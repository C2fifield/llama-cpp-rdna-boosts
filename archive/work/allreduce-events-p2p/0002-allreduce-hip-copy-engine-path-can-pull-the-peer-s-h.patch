From 337ea7439db33bec9779da63c82e34fd948d01a5 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Mon, 12 Oct 2026 16:29:49 +0000
Subject: [PATCH 2/2] allreduce-hip: copy-engine path can pull the peer's half
 directly (GGML_CUDA_AR_P2P_LARGE=1)

Prefill all-reduces (~10 MB at -ub 2048) take the copy-engine path, which bounces both halves through pinned
host memory (D2H, then H2D on the peer): two PCIe crossings per byte.  With GGML_CUDA_AR_P2P_LARGE=1 each
device's AR stream waits for the peer's contribution and pulls it straight into dev_tmp with
hipMemcpyPeerAsync; each compute stream then waits for its own pull and the peer's (which reads this device's
contribution) before the add.  Same add kernel on the same bytes, so the result is bit-identical.

10.5 MB exchange between two R9700s: 808 us via host vs 437 us peer-to-peer.  31.5k-token prefill
(Flash-Next IQ3_XXS + MTP, -sm tensor): +1.3 %, same greedy output.  Unset/0: unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/allreduce-hip.cu | 50 +++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/ggml/src/ggml-cuda/allreduce-hip.cu b/ggml/src/ggml-cuda/allreduce-hip.cu
index e9bae8b27..895c0f45d 100644
--- a/ggml/src/ggml-cuda/allreduce-hip.cu
+++ b/ggml/src/ggml-cuda/allreduce-hip.cu
@@ -611,6 +611,9 @@ struct ggml_cuda_ar_pipeline {
     // record is a marker packet the GPU processes after every AR.
     bool                     ker_recorded[GGML_CUDA_AR_POOL_SIZE];
     bool                     ker_events;
+    // GGML_CUDA_AR_P2P_LARGE: the copy-engine path pulls the peer's contribution straight into dev_tmp with
+    // hipMemcpyPeerAsync instead of bouncing both halves through host_large (one PCIe crossing instead of two).
+    bool                     p2p_large;
 
     // Copy-engine: per-device "I finished reading my peer's host_large"
     // event.  Indexed by RECORDER device.  Recorded same-device on streams[i]
@@ -853,6 +856,7 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
     }
     p->pace             = ggml_cuda_ar_env_u64("GGML_CUDA_AR_PACE", 0) != 0;
     p->ker_events       = ggml_cuda_ar_env_u64("GGML_CUDA_AR_KER_EVENTS", 0) != 0 || p->pace;
+    p->p2p_large        = ggml_cuda_ar_env_u64("GGML_CUDA_AR_P2P_LARGE", 0) != 0;
     for (int s = 0; s < GGML_CUDA_AR_POOL_SIZE; ++s) {
         p->ker_recorded[s] = true;   // pre-recorded at init
     }
@@ -1258,6 +1262,52 @@ static bool ggml_cuda_ar_allreduce_copy_impl(
 
     ggml_backend_cuda_context * cuda_ctx[2] = {};
 
+    if (p->p2p_large) {
+        // 1. Each device's contribution is ready on its AR stream (after its compute, and zeroed if inactive).
+        for (int i = 0; i < 2; ++i) {
+            ggml_cuda_set_device(p->devices[i]);
+            cuda_ctx[i] = static_cast<ggml_backend_cuda_context *>(backends[i]->context);
+            GGML_ASSERT(cuda_ctx[i]->device == p->devices[i]);
+            ggml_cuda_ar_wait_for_compute(p, cuda_ctx[i], i, slot);
+            if (!compute[i]) {
+                CUDA_CHECK(hipMemsetAsync(src_buf[i], 0, nbytes, p->streams[i]));
+            }
+            CUDA_CHECK(hipEventRecord(p->ev_pool[i][slot].cpy[0], p->streams[i]));
+        }
+        // 2. Each device pulls the peer's contribution into its dev_tmp (after the previous add read dev_tmp).
+        for (int i = 0; i < 2; ++i) {
+            const int peer = 1 - i;
+            ggml_cuda_set_device(p->devices[i]);
+            if (p->dev_tmp_kernel_done_valid) {
+                CUDA_CHECK(hipStreamWaitEvent(p->streams[i], p->dev_tmp_kernel_done[i]));
+            }
+            CUDA_CHECK(hipStreamWaitEvent(p->streams[i], p->ev_pool[peer][slot].cpy[0]));
+            CUDA_CHECK(hipMemcpyPeerAsync(p->dev_tmp[i], p->devices[i], src_buf[peer], p->devices[peer], nbytes, p->streams[i]));
+            CUDA_CHECK(hipEventRecord(p->ev_pool[i][slot].h2d, p->streams[i]));
+        }
+        // 3. Each compute stream waits for its own pull (the peer data) and the peer's pull (which reads this device's
+        //    contribution, so it must finish before this device's add or later work overwrites it), then adds.
+        for (int i = 0; i < 2; ++i) {
+            const int peer = 1 - i;
+            ggml_cuda_set_device(p->devices[i]);
+            CUDA_CHECK(hipStreamWaitEvent(cuda_ctx[i]->stream(), p->ev_pool[i][slot].h2d));
+            CUDA_CHECK(hipStreamWaitEvent(cuda_ctx[i]->stream(), p->ev_pool[peer][slot].h2d));
+            const int block_size = 256;
+            int n_blocks = (int) ((ne + block_size - 1) / block_size);
+            if (n_blocks > 1024) {
+                n_blocks = 1024;
+            }
+            ggml_cuda_ar_add_kernel<T_dst, T_src><<<n_blocks, block_size, 0, cuda_ctx[i]->stream()>>>(
+                dst_buf[i], reinterpret_cast<const T_src *>(p->dev_tmp[i]), (int) ne);
+            CUDA_CHECK(hipGetLastError());
+            CUDA_CHECK(hipEventRecord(p->dev_tmp_kernel_done[i], cuda_ctx[i]->stream()));
+            CUDA_CHECK(hipEventRecord(p->ev_pool[i][slot].ker, cuda_ctx[i]->stream()));
+        }
+        p->ker_recorded[slot] = true;
+        p->dev_tmp_kernel_done_valid = true;
+        return true;
+    }
+
     // Stage 1: both GPUs copy their local contribution to pinned host memory.
     for (int i = 0; i < 2; ++i) {
         ggml_cuda_set_device(p->devices[i]);
-- 
