diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 0b90b11d3..13ce83248 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4259,6 +4259,25 @@ static void ggml_backend_cuda_set_tensor_async(ggml_backend_t backend, ggml_tens
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+
+    // A pinned-source cudaMemcpyAsync is read by the copy engine when the stream reaches it, not when it is
+    // issued, so the caller must not modify `data` until the copy has completed.  The scheduler cannot
+    // promise that for this path: it uses set_tensor_async for a host-resident *split* input, and the one
+    // that matters is a CPU split's output (`node_1` / `model.input_embed` in a ROCm_Host buffer), which the
+    // next ubatch's CPU split rewrites.  With GGML_CUDA_ASYNC_INPUT on the host runs ahead, so the copy can
+    // read the next ubatch's bytes (or a torn mix): a rare single-graph corruption that then propagates to
+    // the end of the chunk (wip/async-input-graph-ordering).  Snapshot through the pinned upload ring
+    // instead -- a slot is not reused until the ring wraps, and the wrap is guarded by a device sync.
+    // GGML_CUDA_ASYNC_INPUT=0 (the default) keeps the direct copy.
+    if (g_async_input_on && size > 0 && size <= GGML_CUDA_ASYNC_INPUT_MAX &&
+        ggml_backend_buffer_get_usage(buf) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        // the ring is per device, and the meta (tensor-split) backend forwards set_tensor_async per child,
+        // so do not assume the caller left this backend's device current
+        ggml_cuda_set_device(cuda_ctx->device);
+        if (ggml_cuda_async_input_set(cuda_ctx->device, (char *) tensor->data + offset, data, size)) {
+            return;
+        }
+    }
     ggml_cuda_async_input_drain(cuda_ctx->device);
 
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
