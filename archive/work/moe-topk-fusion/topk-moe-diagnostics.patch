+// Temporary debug (GGML_CUDA_TOPK_MOE_DEBUG=1): where the topk_moe fusion match/guard fails.  Deduped
+// by message so it prints once per (shape, outcome) per process.
+static void topk_moe_dbg(const char * fmt, ...) {
+    static const bool on = getenv("GGML_CUDA_TOPK_MOE_DEBUG") != nullptr;
+    if (!on) {
+        return;
+    }
+    char buf[256];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, args);
+    va_end(args);
+    static std::set<std::string> seen;
+    if (seen.emplace(buf).second) {
+        GGML_LOG_WARN("TOPK_MOE_DBG %s", buf);
+    }
+}
