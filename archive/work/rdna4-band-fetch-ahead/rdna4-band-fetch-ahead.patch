 ...ch-ahead-ncols1_4-ncols2_8-dkq256-dv256.cu |   7 +
 ...ch-ahead-ncols1_8-ncols2_8-dkq256-dv256.cu |   7 +
 .../template-instances/generate_cu_files.py   |  12 +
