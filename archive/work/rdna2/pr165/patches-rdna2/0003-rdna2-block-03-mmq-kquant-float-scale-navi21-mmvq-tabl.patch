From 49b1838f03c2fc0f141e8b8ee8c1a4931ddf213a Mon Sep 17 00:00:00 2001
From: SixVolts <rigel@sixvolts.org>
Date: Fri, 16 Oct 2026 12:00:00 +0000
Subject: [PATCH 03/03] rdna-boosts: rdna2 block 03: mmq k-quant float scale and navi21 mmvq table

Port of the RDNA2 K-quant work from sixvolts/llama-halo-hybrid:

- 1a803b9b: the K-quant MMQ path scales the dot-product accumulation in float
  (ggml_cuda_mmq_scale_sumi in vecdotq.cuh, used by the three K-quant mmq
  implementations).
- 131d89e9: the Navi21 (gfx1030) MMVQ rows_per_block / nwarps table
  (MMVQ_PARAMETERS_NAVI21).

Not ported: halo 4d90f69f (MMVQ float scale) is a no-op on this base -- the
12-block delivery already ships the equivalent ggml_cuda_mul_small (24-bit exact
mul, full rate on AMD) in the MMVQ paths.
---

 0 files changed

diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 7a31e36..305f0fd 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -544,6 +544,17 @@ static __device__ __forceinline__ float vec_dot_q3_K_q8_1_impl_mmq(
     return d3*d8 * sumi;
 }
 
+// scale * dot-sum for the K-quant MMQ and MMVQ paths. The integer product is exact in fp32 (a scale
+// of at most 8 bits times a dot sum below 2^17), and on AMD v_mul_lo_u32 is quarter rate while the
+// float multiply is full rate, so do it in float there. Same result on both paths.
+static __device__ __forceinline__ float ggml_cuda_mmq_scale_sumi(const int sc, const int sumi) {
+#ifdef GGML_USE_HIP
+    return (float) sc * (float) sumi;
+#else
+    return (float) (sc * sumi);
+#endif // GGML_USE_HIP
+}
+
 #define VDR_Q4_K_Q8_1_MMVQ 2
 #define VDR_Q4_K_Q8_1_MMVQ_MOE 4
 #define VDR_Q4_K_Q8_1_MMQ  8
@@ -624,7 +635,7 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1_impl_mmq(
 
         const float2 ds8f = __half22float2(ds8[i]);
 
-        sumf_d += ds8f.x * (sc[i] * sumi_d);
+        sumf_d += ds8f.x * ggml_cuda_mmq_scale_sumi(sc[i], sumi_d);
         sumf_m += ds8f.y *   m[i]; // sum of q8_1 block * q4_K min val
     }
 
@@ -723,7 +734,7 @@ static __device__ __forceinline__ float vec_dot_q5_K_q8_1_impl_mmq(
 
         const float2 ds8f = __half22float2(ds8[i]);
 
-        sumf_d += ds8f.x * (sc[i] * sumi_d);
+        sumf_d += ds8f.x * ggml_cuda_mmq_scale_sumi(sc[i], sumi_d);
         sumf_m += ds8f.y *   m[i]; // sum of q8_1 block * q4_K min val
     }
 
@@ -823,7 +834,7 @@ static __device__ __forceinline__ float vec_dot_q6_K_q8_1_impl_mmq(
             sumi_d.y = ggml_cuda_dp4a(v[2*i+5], u[2*i+5], sumi_d.y); // SIMD dot product
         }
 
-        sumf_d += d8[i0/4] * (sc_reg[i0/2+0]*sumi_d.x + sc_reg[i0/2+1]*sumi_d.y);
+        sumf_d += d8[i0/4] * (ggml_cuda_mmq_scale_sumi(sc_reg[i0/2+0], sumi_d.x) + ggml_cuda_mmq_scale_sumi(sc_reg[i0/2+1], sumi_d.y));
     }
 
     return d6 * sumf_d;

