                     }
                     set_rs_idx(seq_id, (uint32_t) rollback);
@@ -537,6 +548,29 @@ bool llama_memory_recurrent::prepare(const std::vector<llama_ubatch> & ubatches)
         const llama_ubatch & ub = ubatches.back();
         last_ubatch_nseq_tokens = ub.n_seq_tokens;
         last_ubatch_pos_last    = ub.n_tokens > 0 ? ub.pos[ub.n_tokens - 1] : -1;
+        // WIP (issue #131): per-sequence last-batch token count.  Only the sequences present in
