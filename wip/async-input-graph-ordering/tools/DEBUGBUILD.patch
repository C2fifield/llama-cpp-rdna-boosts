+        // compute stream so it reflects the replayed graph's result (no host sync, no pipeline change)
+        static const bool gsum_init = [] {
+            if (cudaMallocHost((void **) &g_ain_gsum_pin, (size_t) AIN_GSUM_MAX * 64) != cudaSuccess) { (void) cudaGetLastError(); return false; }
+            return true;
+        }();
+        if (gsum_init) {
+            const ggml_tensor * onode = nullptr;
+            for (int i = 0; i < cgraph->n_nodes; ++i) {
+                const ggml_tensor * nd = cgraph->nodes[i];
+                if (nd->flags & GGML_TENSOR_FLAG_OUTPUT) { onode = nd; }
+            }
+            if (onode == nullptr) { onode = cgraph->nodes[cgraph->n_nodes - 1]; }
+            if (onode != nullptr) {
+                const size_t nb = std::min<size_t>(64, ggml_nbytes(onode));
+                CUDA_CHECK(cudaMemcpyAsync(g_ain_gsum_pin + g_ain_gsum_n * 64, onode->data, nb,
+                                           cudaMemcpyDeviceToHost, cuda_ctx->stream()));
+            }
+            g_ain_gsum_nnodes[g_ain_gsum_n] = cgraph->n_nodes;
+            snprintf(g_ain_gsum_name[g_ain_gsum_n], sizeof(g_ain_gsum_name[0]), "%s", onode != nullptr ? onode->name : "-");
+            ++g_ain_gsum_n;
+        }
+    }
     return GGML_STATUS_SUCCESS;
 }
 
