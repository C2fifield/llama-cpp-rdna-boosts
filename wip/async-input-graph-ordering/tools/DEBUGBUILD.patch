+static cudaStream_t ggml_cuda_ain_upload_stream(int device) {
+    static const bool expl = getenv("AIN_EXPL_STREAM") != nullptr;
+    if (!expl) {
+        return cudaStreamPerThread;
+    }
+    static cudaStream_t s[GGML_CUDA_MAX_DEVICES] = {};
+    if (s[device] == nullptr) {
+        ggml_cuda_set_device(device);
+        CUDA_CHECK(cudaStreamCreateWithFlags(&s[device], cudaStreamNonBlocking));
+        GGML_LOG_INFO("%s: scratch AIN: explicit upload stream %p on device %d\n", __func__, (void *) s[device], device);
+    }
+    return s[device];
