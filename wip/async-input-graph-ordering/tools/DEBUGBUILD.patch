+    std::mutex  m;
+    int         n = 0;
+    char        name[40][64] = {};
+    long        cnt[40] = {};
+    long        bytes[40] = {};
+    void add(const char * nm, size_t sz) {
+        std::lock_guard<std::mutex> lk(m);
+        for (int i = 0; i < n; ++i) {
+            if (strcmp(name[i], nm) == 0) { ++cnt[i]; bytes[i] += (long) sz; return; }
+        }
+        if (n < 40) { snprintf(name[n], sizeof(name[n]), "%s", nm); cnt[n] = 1; bytes[n] = (long) sz; ++n; }
+    }
+    void dump() {
+        std::lock_guard<std::mutex> lk(m);
+        for (int i = 0; i < n; ++i) {
+            fprintf(stderr, "AIN[name] %-40s sets=%5ld bytes=%ld\n", name[i], cnt[i], bytes[i]);
+        }
+        n = 0;
+    }
