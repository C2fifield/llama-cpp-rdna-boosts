+static void ggml_cuda_ain_seen(std::atomic<int> & n, std::atomic<unsigned long> * ids) {
+    const unsigned long id = (unsigned long) (uintptr_t) pthread_self();
+    for (int i = 0; i < n.load(); ++i) {
+        if (ids[i].load() == id) {
+            return;
+        }
+    }
+    const int k = n.load();
+    if (k < 8 && n.compare_exchange_strong(const_cast<int &>(k), k + 1)) {
+        ids[k].store(id);
+    }
+}
