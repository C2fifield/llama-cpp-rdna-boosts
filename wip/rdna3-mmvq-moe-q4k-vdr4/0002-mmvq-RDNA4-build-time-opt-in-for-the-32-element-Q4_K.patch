From 0ca9a3aec895235fdefa0657c8e8ae1756f8f096 Mon Sep 17 00:00:00 2001
From: "Brian S. Park" <brianspark@hotmail.com>
Date: Fri, 16 Oct 2026 05:46:04 -0700
Subject: [PATCH 2/2] mmvq: RDNA4 build-time opt-in for the 32-element Q4_K dot
 product in MoE experts (default off)

-DGGML_HIP_RDNA4_Q4K_MOE_VDR4 (e.g. via CMAKE_HIP_FLAGS) makes the RDNA4 MoE
expert kernel use vec_dot_q4_K_q8_1_vdr4_dense in place of
vec_dot_q4_K_q8_1_vdr4, as RDNA3_0 now does by default.  Separate from
GGML_HIP_RDNA4_Q4K_DENSE_VDR4 (dense mmvq), so the two can be A/B'd
independently; either, both or neither.  The MoE VDR is 4 either way, so
only the device-side choice changes.  Without the flag nothing changes on
RDNA4.  The flag is also made visible to the host preprocessing: ccache
keys HIP objects on it, and a device-only flag alone would get the cached
object (seen here: the gfx1201 object was byte-identical with and without
the flag until then).  With it the summation order changes, so greedy text can change;
decode and verify share the dot product.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmvq-vecdot.cuh |  6 ++++--
 ggml/src/ggml-cuda/vecdotq.cuh     | 15 +++++++++++++--
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq-vecdot.cuh b/ggml/src/ggml-cuda/mmvq-vecdot.cuh
index 846d17867..f7b0ffe05 100644
--- a/ggml/src/ggml-cuda/mmvq-vecdot.cuh
+++ b/ggml/src/ggml-cuda/mmvq-vecdot.cuh
@@ -34,11 +34,13 @@ static constexpr __device__ vec_dot_q_cuda_t get_vec_dot_q_cuda(ggml_type type,
         case GGML_TYPE_NVFP4:   return vec_dot_nvfp4_q8_1;
         case GGML_TYPE_Q2_K:    return vec_dot_q2_K_q8_1;
         case GGML_TYPE_Q3_K:    return vec_dot_q3_K_q8_1;
-#if defined(RDNA3_0)
-        // MoE takes it too: same 32-element layout and VDR as vec_dot_q4_K_q8_1_vdr4, one integer chain per sub-block
+#if defined(GGML_CUDA_Q4K_DENSE_VDR4) && defined(GGML_CUDA_Q4K_MOE_VDR4)
+        // dense and MoE both: same 32-element layout and VDR as vec_dot_q4_K_q8_1_vdr4, one integer chain per sub-block
         case GGML_TYPE_Q4_K:    return vec_dot_q4_K_q8_1_vdr4_dense;
 #elif defined(GGML_CUDA_Q4K_DENSE_VDR4)
         case GGML_TYPE_Q4_K:    return moe ? vec_dot_q4_K_q8_1_vdr4 : vec_dot_q4_K_q8_1_vdr4_dense;
+#elif defined(GGML_CUDA_Q4K_MOE_VDR4)
+        case GGML_TYPE_Q4_K:    return moe ? vec_dot_q4_K_q8_1_vdr4_dense : vec_dot_q4_K_q8_1;
 #else
         case GGML_TYPE_Q4_K:    return moe ? vec_dot_q4_K_q8_1_vdr4 : vec_dot_q4_K_q8_1;
 #endif
diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 0f748d193..734041d27 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -1206,8 +1206,19 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1_vdr4(
 #if defined(RDNA3_0) || (defined(RDNA4) && defined(GGML_HIP_RDNA4_Q4K_DENSE_VDR4))
 #define GGML_CUDA_Q4K_DENSE_VDR4
 #endif
+// The MoE expert kernel takes it too, in place of vec_dot_q4_K_q8_1_vdr4 (same 32-element layout and VDR): the default
+// on RDNA3_0, a separate build-time opt-in on RDNA4 (-DGGML_HIP_RDNA4_Q4K_MOE_VDR4), with the same caveat on greedy
+// text.  The MoE VDR is 4 either way, so the host side needs nothing.
+#if defined(RDNA3_0) || (defined(RDNA4) && defined(GGML_HIP_RDNA4_Q4K_MOE_VDR4))
+#define GGML_CUDA_Q4K_MOE_VDR4
+#endif
+// The flag only changes device code, but ccache keys HIP objects on the host-side preprocessing (where RDNA4 is
+// never defined), so toggling it alone would return the cached object.  This makes it visible to the host pass.
+#if defined(GGML_HIP_RDNA4_Q4K_MOE_VDR4)
+[[maybe_unused]] static constexpr bool ggml_cuda_rdna4_q4k_moe_vdr4 = true;
+#endif
 
-#if defined(GGML_CUDA_Q4K_DENSE_VDR4)
+#if defined(GGML_CUDA_Q4K_DENSE_VDR4) || defined(GGML_CUDA_Q4K_MOE_VDR4)
 // gfx1100 (RDNA3_0) dense Q4_K mmvq, 32 elements per call (VDR 4).  The two 16-element chunks of a call belong to
 // the same two sub-blocks, so each sub-block's 16 products are summed in one integer dot-product chain before its
 // single scale/convert/fma (|dot1| <= 16*15*127, times the 6-bit scale < 2^21, exact); the mins term uses the same
@@ -1267,7 +1278,7 @@ static __device__ __forceinline__ float vec_dot_q4_K_q8_1_vdr4_dense(
 
     return dm4f.x*sumf_d - dm4f.y*sumf_m;
 }
-#endif // defined(GGML_CUDA_Q4K_DENSE_VDR4)
+#endif // defined(GGML_CUDA_Q4K_DENSE_VDR4) || defined(GGML_CUDA_Q4K_MOE_VDR4)
 
 static __device__ __forceinline__ float vec_dot_q5_K_q8_1(
     const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
-- 
2.43.0

