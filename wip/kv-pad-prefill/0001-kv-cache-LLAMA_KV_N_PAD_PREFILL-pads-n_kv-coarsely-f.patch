From 2912dd73c0ad05d34101a8ee7256b82285672639 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Tue, 13 Oct 2026 03:32:53 +0000
Subject: [PATCH] kv-cache: LLAMA_KV_N_PAD_PREFILL pads n_kv coarsely for
 prompt ubatches, so consecutive chunks reuse one graph

Every 2048-token prompt ubatch grows the cache by 2048 cells, so with the decode pad n_kv - and with it the graph -
changes at every ubatch, and each chunk rebuilds and re-allocates its graph while the GPUs wait.  get_n_kv now takes
the ubatch size; ubatches of more than 64 tokens use LLAMA_KV_N_PAD_PREFILL (rounded up to a power of two) once the
decode-padded occupancy exceeds LLAMA_KV_N_PAD_PREFILL_FROM (default 4096), so qwen4exp's dense shortcut for the
first ~2051 cells still applies.  Decode and verify batches keep the decode pad.  Default 0 = off.

2 x R9700, Qwen3.8-Flash-Next IQ3_XXS all in VRAM, -sm tensor + MTP draft, LLAMA_KV_N_PAD_PREFILL=8192 vs stock
r71: 31.5k-token prefill 2545 -> 2666 t/s (mean of 4, +4.8 %); greedy and long-prompt outputs identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-kv-cache.cpp | 27 ++++++++++++++++++++++++---
 src/llama-kv-cache.h   |  2 +-
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index aa5271156..dcc097417 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -1281,7 +1281,7 @@ uint32_t llama_kv_cache::get_stream(llama_seq_id seq_id) const {
     return seq_to_stream[seq_id];
 }
 
-uint32_t llama_kv_cache::get_n_kv(const slot_info & sinfo) const {
+uint32_t llama_kv_cache::get_n_kv(const slot_info & sinfo, uint32_t n_tokens) const {
     uint32_t result = 0;
 
     // pad the n_kv value so that the graph remains constant across batches and can be reused
@@ -1289,12 +1289,33 @@ uint32_t llama_kv_cache::get_n_kv(const slot_info & sinfo) const {
     // LLAMA_KV_N_PAD_MIN raises the 256-cell floor: n_kv - and with it the graph layout - then stays constant for longer,
     // so fewer captured graphs are invalidated as the context grows (-sm tensor splits each token into ~100 graphs)
     static const uint32_t n_pad_min = getenv("LLAMA_KV_N_PAD_MIN") ? (uint32_t) atoi(getenv("LLAMA_KV_N_PAD_MIN")) : 256u;
+    // LLAMA_KV_N_PAD_PREFILL: a coarser pad for prompt-sized ubatches (> 64 tokens) once the cache is past
+    // LLAMA_KV_N_PAD_PREFILL_FROM cells (default 4096; compared with the decode-padded occupancy).  Every prompt ubatch grows the cache by its own size, so with the
+    // decode pad n_kv - and the graph - changes at every ubatch and the whole graph is rebuilt (split state, allocation);
+    // a pad several ubatches wide lets consecutive ubatches reuse one graph.  Below the threshold the decode pad stays, so
+    // a model's small-context shortcuts keyed on n_kv (qwen4exp's dense attention for the first ~2051 tokens) still apply.
+    // Decode and verify batches keep the decode pad (a coarse pad there slows every step and changes its numerics).
+    // Rounded up to a power of two (GGML_PAD is a bit mask).  0: off.  Not for training (its graphs assert n_kv == n_tokens).
+    static const uint32_t n_pad_prefill = [] {
+        const int      e = getenv("LLAMA_KV_N_PAD_PREFILL") ? atoi(getenv("LLAMA_KV_N_PAD_PREFILL")) : 0;
+        const uint32_t v = e > 0 && e <= (1 << 24) ? (uint32_t) e : 0u;   // ignore negative / absurd values
+        uint32_t p2 = 1;
+        while (p2 < v) {
+            p2 <<= 1;
+        }
+        return v > 0 ? p2 : 0u;
+    }();
+    static const uint32_t n_pad_prefill_from = getenv("LLAMA_KV_N_PAD_PREFILL_FROM") ? (uint32_t) atoi(getenv("LLAMA_KV_N_PAD_PREFILL_FROM")) : 4096u;
     const uint32_t n_pad_cur = std::max(n_pad, n_pad_min);
+    const bool     prefill   = n_tokens > 64 && n_pad_prefill > n_pad_cur;
 
     for (uint32_t s = 0; s < sinfo.n_stream(); ++s) {
         const auto & cells = v_cells[sinfo.strm[s]];
 
-        result = std::max(std::min(cells.size(), std::max(n_pad_cur, GGML_PAD(cells.used_max_p1(), n_pad_cur))), result);
+        const uint32_t used = cells.used_max_p1();
+        const uint32_t pad  = prefill && GGML_PAD(used, n_pad_cur) > n_pad_prefill_from ? n_pad_prefill : n_pad_cur;
+
+        result = std::max(std::min(cells.size(), std::max(pad, GGML_PAD(used, pad))), result);
     }
 
     return result;
@@ -3043,7 +3064,7 @@ bool llama_kv_cache_context::apply() {
     }
 
     kv->apply_ubatch(sinfos[i_cur], ubatches[i_cur]);
-    n_kv = kv->get_n_kv(sinfos[i_cur]);
+    n_kv = kv->get_n_kv(sinfos[i_cur], ubatches[i_cur].n_tokens);
 
     return true;
 }
diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 79aadbade..0456a518a 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -193,7 +193,7 @@ public:
     // graph_build API
     //
 
-    uint32_t get_n_kv(const slot_info & sinfo) const;
+    uint32_t get_n_kv(const slot_info & sinfo, uint32_t n_tokens = 0) const;
 
     // get views of the current state of the cache
     ggml_tensor * get_k(ggml_context * ctx, int32_t il, uint32_t n_kv, const slot_info & sinfo) const;
-- 
2.53.0

