From b01d3bc67b9d8ae7862ea22ea207e003c57f1254 Mon Sep 17 00:00:00 2001
From: "Brian S. Park" <brianspark@hotmail.com>
Date: Fri, 16 Oct 2026 06:56:40 -0700
Subject: [PATCH 2/2] norm: rms_norm_q8_1 quantizes from registers

Each thread quantizes exactly the columns it normalizes, so fold the
dst write loop into the quantize loop and drop the barrier and the dst
reload.  Same arithmetic; bit-identical output.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/norm.cu | 33 +++++++++++----------------------
 1 file changed, 11 insertions(+), 22 deletions(-)

diff --git a/ggml/src/ggml-cuda/norm.cu b/ggml/src/ggml-cuda/norm.cu
index 2de7014e3..1faf821fd 100644
--- a/ggml/src/ggml-cuda/norm.cu
+++ b/ggml/src/ggml-cuda/norm.cu
@@ -697,31 +697,20 @@ static __global__ void rms_norm_q8_1_f32(
     const float mean = tmp / ncols;
     const float scale = rsqrtf(mean + eps);
 
-    if (mul == nullptr) {
-        for (int col = tid; col < ncols; col += block_size) {
-            dst[col] = scale * x[col];
-        }
-    } else {
-        for (int col = tid; col < ncols; col += block_size) {
-            dst[col] = scale * x[col] * mul[col];
-        }
-    }
-
-    __syncthreads();
-
-    if constexpr (has_add) {
-        if (y == nullptr) {
-            return;
-        }
-    }
-
-    // Quantize the row. Warp w covers the 32-element block at col = tid +
-    // k*block_size, so all warps work in parallel and the warp reductions
-    // overlap. The reduction matches the standalone quantize kernel bit for bit.
+    // Each thread quantizes exactly the columns it normalizes, so the scaled value is quantized from
+    // a register (no dst reload or barrier).  Warp w covers the 32-element block at col = tid +
+    // k*block_size, so all warps work in parallel and the warp reductions overlap.  The reduction
+    // matches the standalone quantize kernel bit for bit.
+    // has_add with y == nullptr: the quantize cache is already filled, only dst is written.
+    const bool quantize = !has_add || y != nullptr;
     for (int col = tid; col < ncols; col += block_size) {
+        const float xi = mul == nullptr ? scale * x[col] : scale * x[col] * mul[col];
+        dst[col] = xi;
+        if (!quantize) {
+            continue;
+        }
         const int ib = col / QK8_1;
         const int lane = col % QK8_1;
-        const float xi = dst[col];
         float amax = fabsf(xi);
         float sum  = xi;
         amax = warp_reduce_max(amax);
-- 
