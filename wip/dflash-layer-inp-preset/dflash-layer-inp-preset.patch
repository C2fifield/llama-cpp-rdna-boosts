From a9a19c0505d83060935bcc97e60d6e67649348fd Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Wed, 14 Oct 2026 13:38:40 +0800
Subject: [PATCH] DFlash: size the target's compute buffers for the draft's
 layer-input extraction at context creation

A DFlash draft turns on llama_set_embeddings_layer_inp() for its target layers when it attaches, which is after
the target context was created, reserved and warmed up.  The first request then re-reserves the graph, and
sched_reserve() builds a new scheduler: every compute buffer is freed and allocated again, the main one larger
(Qwen3.8-27B Q5_K_M + DFlash2, -c 220000, -ub 1280: 954.6 -> 1064.6 MiB device, plus the 637.8 MiB host buffer).
On Windows the new allocation landed in shared (system) memory once the card was nearly full, and every step
slowed to a crawl (prefill ~200 t/s); Linux reclaims the freed buffer at once.

common_init_from_params() now reads the draft GGUF's <arch>.target_layers before it creates the target context
and presets them on the target model (llama_model_set_embeddings_layer_inp_preset), so the context's first
reserve already includes the extraction; set_embeddings_layer_inp() no longer asks for a reserve when the flag
does not change.  Outputs and draft acceptance are unchanged; the first request no longer frees or allocates
the compute buffers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/common.cpp     | 23 +++++++++++++++++++++++
 src/llama-context.cpp | 11 +++++++++++
 src/llama-ext.h       |  6 ++++++
 src/llama-model.cpp   |  4 ++++
 src/llama-model.h     |  3 +++
 5 files changed, 47 insertions(+)

diff --git a/common/common.cpp b/common/common.cpp
index 1fdc10d5a..5ce5ccc40 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1383,7 +1383,30 @@ common_init_result::common_init_result(common_params & params, bool model_only)
         llama_model_moe_cache_preflight(model, aux_bytes);
     }
 
+    // a DFlash draft turns on the extraction of some target layers' inputs when it attaches, after this context and its
+    // warm-up: take those layers from the draft's GGUF now, so the first graph reserve already sizes the compute
+    // buffers for them (otherwise they are freed and allocated again, larger, at the first request)
+    if (params.speculative.has_dft() && std::any_of(params.speculative.types.begin(), params.speculative.types.end(), [](auto t) {
+            return t == COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH || t == COMMON_SPECULATIVE_TYPE_DRAFT_DSPARK; })) {
+        gguf_init_params gp = { /*.no_alloc =*/ true, /*.ctx =*/ nullptr };
+        if (gguf_context * g = gguf_init_from_file(params.speculative.draft.mparams.path.c_str(), gp)) {
+            std::vector<int32_t> lids;
+            const int64_t ka = gguf_find_key(g, "general.architecture");
+            const int64_t kl = ka >= 0 ? gguf_find_key(g, (std::string(gguf_get_val_str(g, ka)) + ".target_layers").c_str()) : -1;
+            if (kl >= 0 && gguf_get_kv_type(g, kl) == GGUF_TYPE_ARRAY &&
+                (gguf_get_arr_type(g, kl) == GGUF_TYPE_INT32 || gguf_get_arr_type(g, kl) == GGUF_TYPE_UINT32)) {
+                const int32_t * d = (const int32_t *) gguf_get_arr_data(g, kl);
+                lids.assign(d, d + gguf_get_arr_n(g, kl));
+            }
+            gguf_free(g);
+            if (!lids.empty()) {
+                llama_model_set_embeddings_layer_inp_preset(model, lids.data(), (uint32_t) lids.size());
+            }
+        }
+    }
+
     llama_context * lctx = llama_init_from_model(model, cparams);
+    llama_model_set_embeddings_layer_inp_preset(model, nullptr, 0); // only this context: not an MTP draft context made later
     if (lctx == NULL) {
         COM_ERR("failed to create context with model '%s'\n", params.model.path.c_str());
         return;
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 8e9fd895e..72cc5139f 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -310,6 +310,11 @@ llama_context::llama_context(
     // +1: id n_layer() taps the output of the last layer ("input" of the head)
     cparams.embeddings_layer_inp.resize(hparams.n_layer() + 1, false);
     embd_layer_inp.resize(hparams.n_layer() + 1);
+    for (const int32_t lid : model.embeddings_layer_inp_preset) {
+        if (lid >= 0 && (size_t) lid < cparams.embeddings_layer_inp.size()) {
+            cparams.embeddings_layer_inp[lid] = true;
+        }
+    }
 
     cparams.ctx_type          = params.ctx_type;
     cparams.rope_scaling_type = params.rope_scaling_type;
@@ -1649,6 +1654,12 @@ void llama_context::set_embeddings_layer_inp(uint32_t lid, bool enable) {
 
     GGML_ASSERT(lid <= model.hparams.n_layer());
 
+    if (cparams.embeddings_layer_inp[lid] == enable) {
+        // unchanged (preset at context creation): the reserved graph has it already, and a reserve would free and
+        // allocate all compute buffers again
+        return;
+    }
+
     cparams.embeddings_layer_inp[lid] = enable;
 
     // note: without this reserve, the draft acceptance drops to zero. not sure why - this is unexpected
diff --git a/src/llama-ext.h b/src/llama-ext.h
index 9ac8eff63..170efb75a 100644
--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -164,6 +164,12 @@ LLAMA_API const int32_t * llama_model_target_layer_ids  (const struct llama_mode
 // returns the number of extracted layers from target model
 LLAMA_API uint32_t        llama_model_target_layer_ids_n(const struct llama_model * model);
 
+// layers whose input embeddings contexts created from this model extract from the start (as if
+// llama_set_embeddings_layer_inp(ctx, lid, true) had been called before the context's first graph reserve).
+// For a target whose draft will turn the extraction on (DFlash): the compute buffers are then sized for it once,
+// instead of being freed and allocated again, larger, at the first decode after the draft attaches.
+LLAMA_API void llama_model_set_embeddings_layer_inp_preset(struct llama_model * model, const int32_t * lids, uint32_t n);
+
 // retrieves the whole token embedding matrix in F32 format (n_embd * n_vocab)
 // returns total number of elements or 0 on error
 // if out is nullptr, returns the number of tokens without writing to out
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 7d2af8622..da5883a81 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -4089,6 +4089,10 @@ uint32_t llama_model_target_layer_ids_n(const struct llama_model * model) {
     return (uint32_t) model->target_layer_ids.size();
 }
 
+void llama_model_set_embeddings_layer_inp_preset(struct llama_model * model, const int32_t * lids, uint32_t n) {
+    model->embeddings_layer_inp_preset.assign(lids, lids + n);
+}
+
 uint32_t llama_model_get_tok_embd(const struct llama_model * model, float * out) {
     if (model->vocab.n_tokens() == 0 || model->tok_embd == nullptr) {
         return 0;
diff --git a/src/llama-model.h b/src/llama-model.h
index 50731dfce..c345789c3 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -764,6 +764,9 @@ struct llama_model {
     // unified vector to store target-model extracted layer ids in eagle3, dflash, etc.
     std::vector<int32_t> target_layer_ids;
 
+    // layers whose input embeddings new contexts extract from the start (llama_model_set_embeddings_layer_inp_preset)
+    std::vector<int32_t> embeddings_layer_inp_preset;
+
     std::vector<llama_layer> layers;
 
     //Dense linear projections for SentenceTransformers models like embeddinggemma
-- 
