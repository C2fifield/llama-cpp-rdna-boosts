From cb1a2a92763b91d64c1414deaeb8fd03b2894fdf Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Mon, 12 Oct 2026 14:41:34 +0000
Subject: [PATCH 1/2] allreduce-hip: chunked kernel path no longer records
 ev.ker per AR (GGML_CUDA_AR_KER_EVENTS=1 restores)

acquire_slot synchronizes the host on ev_pool[*][slot].ker of the AR that last used the slot, and the chunked
kernel path recorded that event after every AR on every device: on ROCm a marker packet the GPU processes after
each AR kernel, before the next graph.  The kernel path's slot reuse is already ordered on the GPUs (a device's
kernel N completes only after it saw the peer's arrival token for N, which the peer writes after its kernel N-1
finished reading this device's slot data; tokens are monotonic), so the kernel path now records it only with
GGML_CUDA_AR_KER_EVENTS=1 or pacing, and acquire_slot syncs only when the slot's last user recorded it.  The
copy-engine path is unchanged.

2 x R9700, Flash-Next IQ3_XXS + MTP, -sm tensor: greedy 139.2-141.1 -> 143.2-144.9 t/s (with the topk_moe
change), same greedy output, 0 AR timeouts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/allreduce-hip.cu | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/allreduce-hip.cu b/ggml/src/ggml-cuda/allreduce-hip.cu
index d956c71d0..e9bae8b27 100644
--- a/ggml/src/ggml-cuda/allreduce-hip.cu
+++ b/ggml/src/ggml-cuda/allreduce-hip.cu
@@ -605,6 +605,12 @@ struct ggml_cuda_ar_pipeline {
     char *                    dev_tmp[GGML_CUDA_MAX_DEVICES];    // device scratch for copy-engine path
     hipStream_t              streams[GGML_CUDA_MAX_DEVICES];   // non-blocking
     ggml_cuda_ar_event_slot  ev_pool[GGML_CUDA_MAX_DEVICES][GGML_CUDA_AR_POOL_SIZE];
+    // Whether the slot's last user recorded ev_pool[*][slot].ker (acquire_slot syncs only then).  The chunked kernel
+    // path records it only with ker_events (GGML_CUDA_AR_KER_EVENTS=1) or pacing: its slot reuse is already
+    // ordered on the GPUs (a device enters AR N only after its peer arrived at N-1, i.e. finished N-2), and each
+    // record is a marker packet the GPU processes after every AR.
+    bool                     ker_recorded[GGML_CUDA_AR_POOL_SIZE];
+    bool                     ker_events;
 
     // Copy-engine: per-device "I finished reading my peer's host_large"
     // event.  Indexed by RECORDER device.  Recorded same-device on streams[i]
@@ -751,7 +757,7 @@ static ggml_cuda_ar_slot_info ggml_cuda_ar_acquire_slot(ggml_cuda_ar_pipeline *
     const bool pool_lapped = p->call_count >= GGML_CUDA_AR_POOL_SIZE;
     p->call_count++;
 
-    if (pool_lapped) {
+    if (pool_lapped && p->ker_recorded[slot]) {
         for (int i = 0; i < p->n_devices; ++i) {
             ggml_cuda_set_device(p->devices[i]);
             CUDA_CHECK(hipEventSynchronize(p->ev_pool[i][slot].ker));
@@ -846,6 +852,10 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
                       "stage kernel is captured into subgraph graphs (WIP)\n", __func__);
     }
     p->pace             = ggml_cuda_ar_env_u64("GGML_CUDA_AR_PACE", 0) != 0;
+    p->ker_events       = ggml_cuda_ar_env_u64("GGML_CUDA_AR_KER_EVENTS", 0) != 0 || p->pace;
+    for (int s = 0; s < GGML_CUDA_AR_POOL_SIZE; ++s) {
+        p->ker_recorded[s] = true;   // pre-recorded at init
+    }
     if (p->pace) {
         GGML_LOG_WARN("%s: host-side lockstep pacing enabled (GGML_CUDA_AR_PACE=1); "
                       "poll peers' prev AR before enqueueing (WIP)\n", __func__);
@@ -1336,6 +1346,7 @@ static bool ggml_cuda_ar_allreduce_copy_impl(
         CUDA_CHECK(hipEventRecord(p->dev_tmp_kernel_done[i], cuda_ctx[i]->stream()));
         CUDA_CHECK(hipEventRecord(p->ev_pool[i][slot].ker, cuda_ctx[i]->stream()));
     }
+    p->ker_recorded[slot] = true;
     p->host_large_read_done_valid = true;
     p->dev_tmp_kernel_done_valid = true;
 
@@ -1643,10 +1654,11 @@ bool ggml_cuda_ar_allreduce(
 #undef LAUNCH_AR_KERNEL
                 CUDA_CHECK(hipGetLastError());
 
-                if (last_chunk) {
+                if (last_chunk && p->ker_events) {
                     CUDA_CHECK(hipEventRecord(p->ev_pool[i][slot].ker, stream));
                 }
             }
+            p->ker_recorded[slot] = last_chunk && p->ker_events;
         }
     }
 
