+                for (ggml_tensor * t : res->t_sampled_logits) { sync_readback(t); }
+                for (ggml_tensor * t : res->t_sampled_probs)  { sync_readback(t); }
+                for (ggml_tensor * t : res->t_candidates)     { sync_readback(t); }
+            }
