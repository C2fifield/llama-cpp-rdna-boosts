+static int64_t moe_host_pool_mib() {
+    static const int64_t v = [] {
+        const char * e = getenv("MOE_HOST_POOL_MIB");
+        if (e == nullptr || e[0] == '\0') {
+            return (int64_t) -2;  // unset: the pool is on only if MOE_HOST_POOL=1 (size defaults to FRAC %)
