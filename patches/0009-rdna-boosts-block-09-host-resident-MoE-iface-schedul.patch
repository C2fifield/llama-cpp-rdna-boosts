+    static const bool dbg = getenv("GGML_CUDA_FUSE_CPY_BATCH_DEBUG") != nullptr;
+    if (dbg) fprintf(stderr, "cpy_batch: %d copies over nodes %d..%d (%lld elements each)\n", n, i, last, (long long) ne);
+    return last - i + 1;
+}
